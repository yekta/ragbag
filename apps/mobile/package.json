{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "//start": "Metro, deliberately NOT named `dev`: `pnpm dev` at the root fans out to every package with a dev script, and a bundler that only a phone or simulator can talk to has no business starting alongside the API and Vite. The root `dev:mobile` runs this on purpose.",
    "start": "expo start --clear",
    "start:lan": "expo start --dev-client --lan --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc"
  },

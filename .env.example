# Copy to .env. One file, two audiences: the API server and zero-cache-dev read
# it directly for local dev, and docker-compose reads it for ${...} substitution.

# --- Postgres: fill in ONE of the two, depending on who runs the database ---
#
# 1. You run it (local dev, or a managed one like Railway). DATABASE_URL is the
#    only setting that matters and POSTGRES_PASSWORD below is ignored.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragbag
#
# 2. `docker compose up` runs it. Then POSTGRES_PASSWORD is the only setting
#    that matters: compose initialises the database with it and builds the URLs
#    for the server and zero-cache from it, so DATABASE_URL above never reaches
#    the containers. It cannot be one variable for both, because the same URL
#    cannot be: inside the compose network the host is `postgres`, and from your
#    machine it is `localhost`. The postgres image also wants a password, not a
#    connection string.
POSTGRES_PASSWORD=postgres

# --- API server ---
PORT=3001
BETTER_AUTH_SECRET=dev-only-secret-change-me
# Browser-facing base URL of the auth endpoints. In dev the Vite server
# proxies /api to the API, so this is the web origin.
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Production only, when web/API/zero-cache sit on sibling subdomains: issues
# the session cookie for the parent domain so all three see it (zero-cache
# authenticates by forwarding that cookie). Must be a registrable domain,
# e.g. ".ragbag.app". Leave unset in dev: localhost cookies ignore the port.
#COOKIE_DOMAIN=

# Google OAuth, the only sign-in method (§9). Create at console.cloud.google.com;
# authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev/test only: anonymous sign-in so the sync scratch page works without
# Google credentials. The server refuses to boot with this in production.
DEV_LOGIN=true

# --- Blobs: Cloudflare R2 or any S3-compatible bucket ---
# Leave empty to use local-disk storage instead: files under LOCAL_BLOB_DIR,
# served by the API through HMAC-presigned URLs. That's the default in dev
# (.data/blobs); in production it must be set explicitly (e.g. a mounted
# volume) or blob uploads stay disabled.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
#LOCAL_BLOB_DIR=.data/blobs

# --- Ingestion + AI (plan §5) ---
# Without a key the pipeline still extracts everything it can locally (PDF
# text layers, textual files); image descriptions, transcripts, summaries,
# tags and entities are skipped. Production refuses to boot without a key.
OPENAI_API_KEY=
#OPENAI_BASE_URL=
# Vision, the scanned-PDF pass and message synthesis share this one. Both of
# these are checked at boot against the allow-list in ingest/models.ts, which
# is also where their prices live: a model the server cannot price would meter
# every call at $0.00, so it refuses to start instead.
# gpt-5.6-luna is the cheap high-volume tier; gpt-5.6-terra and gpt-5.6-sol
# are the step-ups, at 10x and 25x the output rate.
#AI_ENRICH_MODEL=gpt-5.6-luna
# Transcription, billed by the minute ($0.0045) rather than by tokens. It
# returns the words but no timings, so a voice note reads as a paragraph
# rather than a list of timecodes to seek by.
#AI_TRANSCRIBE_MODEL=gpt-transcribe
# Audio the endpoint will not read (.opus voice notes, AMR, AIFF, anything
# over 24 MB) is converted first with the ffmpeg the server ships with. Set
# this to use a system one instead.
#FFMPEG_PATH=/usr/bin/ffmpeg
# A scanned PDF is the most expensive single dump: one API call, but the model
# renders every page to an image, so cost scales with pages and with detail.
#AI_PDF_DETAIL=low
#AI_PDF_MAX_PAGES=50
# The ingest worker runs inside the API process; set false on API instances
# when a dedicated worker deployment takes over.
#INGEST_WORKER=true
#INGEST_CONCURRENCY=2

# --- zero-cache (dev: `pnpm dev:zero-cache`; compose sets its own) ---
# Defaults to DATABASE_URL, so the password is not written a third time. Set it
# only when zero-cache needs a DIFFERENT url from the API's: on Railway that is
# the direct, non-pooled one, because logical replication cannot go through a
# connection pooler (DEPLOY.md §3).
#ZERO_UPSTREAM_DB=
ZERO_REPLICA_FILE=/tmp/ragbag-zero-replica.db
ZERO_APP_PUBLICATIONS=zero_data
ZERO_MUTATE_URL=http://localhost:3001/api/zero/mutate
ZERO_QUERY_URL=http://localhost:3001/api/zero/query
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_ENABLE_CRUD_MUTATIONS=false

# --- web (Vite; only VITE_-prefixed vars reach the browser) ---
# Baked in at build time: changing either needs a rebuild, not a restart.
VITE_ZERO_CACHE_URL=http://localhost:4848
# API origin. Unset in dev: the Vite server proxies /api, keeping the session
# cookie first-party. In production set it to e.g. https://api.ragbag.app.
#VITE_API_URL=

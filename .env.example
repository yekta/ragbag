# Copy to .env. Used by docker-compose and (for local dev) by the API server
# and zero-cache-dev, which both read this file from the repo root.

# --- Postgres (compose runs pgvector/pgvector:pg17 with wal_level=logical) ---
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragbag

# --- API server ---
PORT=3001
BETTER_AUTH_SECRET=dev-only-secret-change-me
# Browser-facing base URL of the auth endpoints. In dev the Vite server
# proxies /api to the API, so this is the web origin.
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Google OAuth — the only sign-in method (§9). Create at console.cloud.google.com;
# authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev/test only: anonymous sign-in so the sync scratch page works without
# Google credentials. The server refuses to boot with this in production.
DEV_LOGIN=true

# --- Blobs: Cloudflare R2 or any S3-compatible bucket ---
# Leave empty to use local-disk storage instead: files under LOCAL_BLOB_DIR,
# served by the API through HMAC-presigned URLs. That's the default in dev
# (.data/blobs); in production it must be set explicitly (e.g. a mounted
# volume) or blob uploads stay disabled.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
#LOCAL_BLOB_DIR=.data/blobs

# --- Ingestion + AI (§7/§8) ---
# Without a key the pipeline still classifies, extracts, and indexes content —
# it just skips AI summaries/tags/embeddings.
OPENAI_API_KEY=
#OPENAI_BASE_URL=
#AI_ENRICH_MODEL=gpt-5.6-luna
#AI_EMBED_MODEL=text-embedding-3-small
# Per-user rolling-24h AI spend cap in USD; enrichment is skipped above it.
#AI_USER_DAILY_BUDGET_USD=1
# The ingest worker runs inside the API process; set false on API instances
# when a dedicated worker deployment takes over.
#INGEST_WORKER=true
#INGEST_CONCURRENCY=2

# --- zero-cache (dev: `pnpm dev:zero-cache`; compose sets its own) ---
ZERO_UPSTREAM_DB=postgresql://postgres:postgres@localhost:5432/ragbag
ZERO_REPLICA_FILE=/tmp/ragbag-zero-replica.db
ZERO_APP_PUBLICATIONS=zero_data
ZERO_MUTATE_URL=http://localhost:3001/api/zero/mutate
ZERO_QUERY_URL=http://localhost:3001/api/zero/query
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_ENABLE_CRUD_MUTATIONS=false

# --- web (Vite; only VITE_-prefixed vars reach the browser) ---
VITE_ZERO_CACHE_URL=http://localhost:4848
